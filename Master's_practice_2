{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1ZkwXqjKK7mrtWO-9fx5SnPep8rpNYbWD","timestamp":1758847373530}],"authorship_tag":"ABX9TyNLC45xQeHmiCHJX9fKZN6r"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from sklearn.model_selection import train_test_split, KFold\n","from sklearn.preprocessing import StandardScaler, MinMaxScaler, RobustScaler\n","from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n","import tensorflow as tf\n","from tensorflow import keras\n","from tensorflow.keras import layers, regularizers\n","from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau, ModelCheckpoint\n","from tensorflow.keras.optimizers import Adam, RMSprop\n","import pickle\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","# Set random seeds for reproducibility\n","np.random.seed(42)\n","tf.random.set_seed(42)\n","\n","print(\"🚀 OPTIMIZED NEURAL NETWORK FOR MURAKAMI MODEL\")\n","print(\"=\"*60)\n","print(\"🎯 Target: Achieve R² > 0.95 for endurance limit prediction\")\n","print(\"=\"*60)\n","\n","# Load the data\n","data = pd.read_excel('Generated data for ML of Murakami model.xlsx')\n","\n","# Extract features with proper names\n","area = data['defect size sqrt. Area [μm]'].values\n","surface_defect = data['Surface Defect (1=yes, no otherwise)'].values\n","hardness = data['Vickers hardness HV [kg/mm2]'].values\n","target = data['lower bound endurance limit σ_w [MPa]'].values\n","\n","print(f\"📊 Dataset Analysis:\")\n","print(f\"   • Samples: {len(data)}\")\n","print(f\"   • Area range: {area.min():.1f} - {area.max():.1f} μm\")\n","print(f\"   • Hardness range: {hardness.min():.1f} - {hardness.max():.1f} kg/mm²\")\n","print(f\"   • Target range: {target.min():.1f} - {target.max():.1f} MPa\")\n","\n","# OPTIMIZATION 1: FEATURE ENGINEERING - Add physics-inspired features\n","print(f\"\\n🔧 OPTIMIZATION 1: Advanced Feature Engineering\")\n","print(\"-\" * 40)\n","\n","def create_engineered_features(area, surface_defect, hardness):\n","    \"\"\"\n","    Create physics-inspired features based on Murakami equation structure\n","    \"\"\"\n","    features = []\n","\n","    # Original features\n","    features.append(area)                           # defect size\n","    features.append(surface_defect)                 # surface defect flag\n","    features.append(hardness)                       # hardness\n","\n","    # Physics-inspired features from Murakami equation\n","    features.append(hardness + 120)                 # adjusted hardness (from equation)\n","    features.append(area ** (1/6))                  # area^(1/6) term from equation\n","    features.append((hardness + 120) / (area ** (1/6)))  # core Murakami term\n","\n","    # Additional engineered features\n","    features.append(np.log(area + 1))               # log of area (handle small values)\n","    features.append(np.sqrt(hardness))              # sqrt of hardness\n","    features.append(area * hardness)                # interaction term\n","    features.append(hardness / np.sqrt(area))       # hardness per sqrt area\n","\n","    # Surface defect interactions\n","    features.append(surface_defect * hardness)      # surface effect on hardness\n","    features.append(surface_defect * area)          # surface effect on area\n","    features.append(surface_defect * (hardness + 120) / (area ** (1/6)))  # Murakami with surface\n","\n","    return np.array(features).T\n","\n","# Create engineered features\n","X_engineered = create_engineered_features(area, surface_defect, hardness)\n","feature_names = [\n","    'area', 'surface_defect', 'hardness',\n","    'hardness_adj', 'area_sixth', 'murakami_core',\n","    'log_area', 'sqrt_hardness', 'area_hardness',\n","    'hardness_per_sqrt_area', 'surface_hardness',\n","    'surface_area', 'surface_murakami'\n","]\n","\n","print(f\"✅ Created {X_engineered.shape[1]} engineered features:\")\n","for i, name in enumerate(feature_names):\n","    print(f\"   {i+1:2d}. {name}\")\n","\n","# OPTIMIZATION 2: MULTIPLE SCALING STRATEGIES\n","print(f\"\\n🔧 OPTIMIZATION 2: Advanced Preprocessing\")\n","print(\"-\" * 40)\n","\n","def test_scalers(X, y):\n","    \"\"\"Test different scaling strategies\"\"\"\n","    scalers = {\n","        'StandardScaler': StandardScaler(),\n","        'MinMaxScaler': MinMaxScaler(),\n","        'RobustScaler': RobustScaler(),\n","    }\n","\n","    best_scaler = None\n","    best_score = -np.inf\n","\n","    for name, scaler in scalers.items():\n","        # Quick cross-validation test\n","        kfold = KFold(n_splits=3, shuffle=True, random_state=42)\n","        scores = []\n","\n","        for train_idx, val_idx in kfold.split(X):\n","            X_train, X_val = X[train_idx], X[val_idx]\n","            y_train, y_val = y[train_idx], y[val_idx]\n","\n","            X_train_scaled = scaler.fit_transform(X_train)\n","            X_val_scaled = scaler.transform(X_val)\n","\n","            # Simple linear model test for scaler evaluation\n","            from sklearn.linear_model import Ridge\n","            model = Ridge(alpha=0.1)\n","            model.fit(X_train_scaled, y_train)\n","            pred = model.predict(X_val_scaled)\n","            score = r2_score(y_val, pred)\n","            scores.append(score)\n","\n","        avg_score = np.mean(scores)\n","        print(f\"   • {name}: R² = {avg_score:.4f}\")\n","\n","        if avg_score > best_score:\n","            best_score = avg_score\n","            best_scaler = scaler\n","\n","    print(f\"✅ Best scaler: {best_scaler.__class__.__name__} (R² = {best_score:.4f})\")\n","    return best_scaler\n","\n","best_scaler = test_scalers(X_engineered, target)\n","\n","# OPTIMIZATION 3: OPTIMIZED ARCHITECTURE\n","print(f\"\\n🔧 OPTIMIZATION 3: Optimized Network Architecture\")\n","print(\"-\" * 40)\n","\n","def create_optimized_model(input_dim, architecture='deep'):\n","    \"\"\"Create optimized neural network architecture\"\"\"\n","\n","    if architecture == 'deep':\n","        # Deep network with residual-like connections\n","        inputs = layers.Input(shape=(input_dim,))\n","\n","        # First block\n","        x1 = layers.Dense(256, activation='relu')(inputs)\n","        x1 = layers.BatchNormalization()(x1)\n","        x1 = layers.Dropout(0.3)(x1)\n","\n","        # Second block\n","        x2 = layers.Dense(128, activation='relu')(x1)\n","        x2 = layers.BatchNormalization()(x2)\n","        x2 = layers.Dropout(0.2)(x2)\n","\n","        # Third block with skip connection\n","        x3 = layers.Dense(64, activation='relu')(x2)\n","        x3 = layers.BatchNormalization()(x3)\n","        x3 = layers.Dropout(0.2)(x3)\n","\n","        # Fourth block\n","        x4 = layers.Dense(32, activation='relu')(x3)\n","        x4 = layers.BatchNormalization()(x4)\n","        x4 = layers.Dropout(0.1)(x4)\n","\n","        # Final layers\n","        x5 = layers.Dense(16, activation='relu')(x4)\n","        outputs = layers.Dense(1, activation='linear')(x5)\n","\n","        model = keras.Model(inputs=inputs, outputs=outputs)\n","\n","    elif architecture == 'wide':\n","        # Wide network\n","        model = keras.Sequential([\n","            layers.Dense(512, activation='relu', input_dim=input_dim),\n","            layers.BatchNormalization(),\n","            layers.Dropout(0.4),\n","\n","            layers.Dense(256, activation='relu'),\n","            layers.BatchNormalization(),\n","            layers.Dropout(0.3),\n","\n","            layers.Dense(128, activation='relu'),\n","            layers.BatchNormalization(),\n","            layers.Dropout(0.2),\n","\n","            layers.Dense(1, activation='linear')\n","        ])\n","\n","    return model\n","\n","# Test different architectures\n","architectures = ['deep', 'wide']\n","best_architecture = None\n","best_val_score = -np.inf\n","\n","print(\"Testing architectures:\")\n","for arch in architectures:\n","    print(f\"\\n   Testing {arch} architecture...\")\n","\n","    # Quick validation\n","    X_temp, X_val, y_temp, y_val = train_test_split(\n","        X_engineered, target, test_size=0.2, random_state=42\n","    )\n","    X_train, _, y_train, _ = train_test_split(\n","        X_temp, y_temp, test_size=0.25, random_state=42\n","    )\n","\n","    # Scale data\n","    X_train_scaled = best_scaler.fit_transform(X_train)\n","    X_val_scaled = best_scaler.transform(X_val)\n","\n","    # Build and train model\n","    model = create_optimized_model(X_train_scaled.shape[1], arch)\n","    model.compile(\n","        optimizer=Adam(learning_rate=0.001),\n","        loss='mse',\n","        metrics=['mae']\n","    )\n","\n","    # Quick training\n","    history = model.fit(\n","        X_train_scaled, y_train,\n","        validation_data=(X_val_scaled, y_val),\n","        epochs=50,\n","        batch_size=16,\n","        verbose=0\n","    )\n","\n","    val_score = max(history.history['val_loss'])\n","    val_score = r2_score(y_val, model.predict(X_val_scaled, verbose=0).flatten())\n","\n","    print(f\"      Validation R²: {val_score:.4f}\")\n","\n","    if val_score > best_val_score:\n","        best_val_score = val_score\n","        best_architecture = arch\n","\n","print(f\"✅ Best architecture: {best_architecture} (R² = {best_val_score:.4f})\")\n","\n","# OPTIMIZATION 4: HYPERPARAMETER TUNING\n","print(f\"\\n🔧 OPTIMIZATION 4: Hyperparameter Optimization\")\n","print(\"-\" * 40)\n","\n","def optimize_hyperparameters(X_train_scaled, y_train, X_val_scaled, y_val):\n","    \"\"\"Find optimal hyperparameters\"\"\"\n","\n","    best_params = None\n","    best_score = -np.inf\n","\n","    # Hyperparameter grid\n","    param_grid = {\n","        'learning_rate': [0.001, 0.003, 0.01],\n","        'batch_size': [8, 16, 32],\n","        'dropout_rate': [0.2, 0.3, 0.4]\n","    }\n","\n","    print(\"Testing hyperparameter combinations:\")\n","\n","    for lr in param_grid['learning_rate']:\n","        for bs in param_grid['batch_size']:\n","            for dr in param_grid['dropout_rate']:\n","                print(f\"   • LR={lr}, BS={bs}, DR={dr}...\", end=' ')\n","\n","                # Create model with current params\n","                model = keras.Sequential([\n","                    layers.Dense(256, activation='relu', input_dim=X_train_scaled.shape[1]),\n","                    layers.BatchNormalization(),\n","                    layers.Dropout(dr),\n","\n","                    layers.Dense(128, activation='relu'),\n","                    layers.BatchNormalization(),\n","                    layers.Dropout(dr * 0.7),\n","\n","                    layers.Dense(64, activation='relu'),\n","                    layers.BatchNormalization(),\n","                    layers.Dropout(dr * 0.5),\n","\n","                    layers.Dense(32, activation='relu'),\n","                    layers.Dropout(dr * 0.3),\n","\n","                    layers.Dense(1)\n","                ])\n","\n","                model.compile(\n","                    optimizer=Adam(learning_rate=lr),\n","                    loss='mse',\n","                    metrics=['mae']\n","                )\n","\n","                # Train with early stopping\n","                history = model.fit(\n","                    X_train_scaled, y_train,\n","                    validation_data=(X_val_scaled, y_val),\n","                    epochs=30,\n","                    batch_size=bs,\n","                    verbose=0,\n","                    callbacks=[EarlyStopping(patience=10, restore_best_weights=True)]\n","                )\n","\n","                # Evaluate\n","                pred = model.predict(X_val_scaled, verbose=0).flatten()\n","                score = r2_score(y_val, pred)\n","\n","                print(f\"R² = {score:.4f}\")\n","\n","                if score > best_score:\n","                    best_score = score\n","                    best_params = {'lr': lr, 'bs': bs, 'dr': dr}\n","\n","    print(f\"✅ Best hyperparameters: {best_params} (R² = {best_score:.4f})\")\n","    return best_params\n","\n","# FINAL OPTIMIZED TRAINING\n","print(f\"\\n🏆 FINAL OPTIMIZED MODEL TRAINING\")\n","print(\"=\"*50)\n","\n","# Prepare final datasets\n","X_temp, X_test, y_temp, y_test = train_test_split(\n","    X_engineered, target, test_size=0.2, random_state=42, shuffle=True\n",")\n","\n","X_train, X_val, y_train, y_val = train_test_split(\n","    X_temp, y_temp, test_size=0.25, random_state=42, shuffle=True\n",")\n","\n","# Apply best scaling\n","final_scaler = best_scaler.fit(X_train)\n","X_train_scaled = final_scaler.transform(X_train)\n","X_val_scaled = final_scaler.transform(X_val)\n","X_test_scaled = final_scaler.transform(X_test)\n","\n","print(f\"Data splits: Train={len(X_train)}, Val={len(X_val)}, Test={len(X_test)}\")\n","\n","# Optimize hyperparameters\n","best_params = optimize_hyperparameters(X_train_scaled, y_train, X_val_scaled, y_val)\n","\n","# Build final optimized model\n","print(f\"\\n🏗️ Building final optimized model...\")\n","final_model = keras.Sequential([\n","    layers.Dense(256, activation='relu', input_dim=X_train_scaled.shape[1],\n","                kernel_regularizer=regularizers.l2(0.001)),\n","    layers.BatchNormalization(),\n","    layers.Dropout(best_params['dr']),\n","\n","    layers.Dense(128, activation='relu',\n","                kernel_regularizer=regularizers.l2(0.001)),\n","    layers.BatchNormalization(),\n","    layers.Dropout(best_params['dr'] * 0.7),\n","\n","    layers.Dense(64, activation='relu',\n","                kernel_regularizer=regularizers.l2(0.001)),\n","    layers.BatchNormalization(),\n","    layers.Dropout(best_params['dr'] * 0.5),\n","\n","    layers.Dense(32, activation='relu'),\n","    layers.Dropout(best_params['dr'] * 0.3),\n","\n","    layers.Dense(16, activation='relu'),\n","\n","    layers.Dense(1, activation='linear')\n","])\n","\n","# Compile with optimized parameters\n","final_model.compile(\n","    optimizer=Adam(learning_rate=best_params['lr'], clipnorm=1.0),\n","    loss='mse',\n","    metrics=['mae']\n",")\n","\n","# Advanced callbacks\n","callbacks = [\n","    EarlyStopping(\n","        monitor='val_loss',\n","        patience=30,\n","        restore_best_weights=True,\n","        verbose=1\n","    ),\n","    ReduceLROnPlateau(\n","        monitor='val_loss',\n","        factor=0.5,\n","        patience=15,\n","        min_lr=1e-7,\n","        verbose=1\n","    ),\n","    ModelCheckpoint(\n","        'best_murakami_model.h5',\n","        monitor='val_loss',\n","        save_best_only=True,\n","        verbose=0\n","    )\n","]\n","\n","print(f\"🚀 Training optimized model...\")\n","print(f\"   • Architecture: {best_architecture}\")\n","print(f\"   • Features: {X_train_scaled.shape[1]} engineered features\")\n","print(f\"   • Hyperparameters: {best_params}\")\n","\n","# Train the final model\n","history = final_model.fit(\n","    X_train_scaled, y_train,\n","    validation_data=(X_val_scaled, y_val),\n","    epochs=200,\n","    batch_size=best_params['bs'],\n","    callbacks=callbacks,\n","    verbose=1\n",")\n","\n","# Final evaluation\n","print(f\"\\n📊 FINAL MODEL PERFORMANCE\")\n","print(\"=\"*50)\n","\n","# Predictions\n","y_train_pred = final_model.predict(X_train_scaled, verbose=0).flatten()\n","y_val_pred = final_model.predict(X_val_scaled, verbose=0).flatten()\n","y_test_pred = final_model.predict(X_test_scaled, verbose=0).flatten()\n","\n","# Calculate metrics\n","def print_metrics(y_true, y_pred, set_name):\n","    mse = mean_squared_error(y_true, y_pred)\n","    rmse = np.sqrt(mse)\n","    mae = mean_absolute_error(y_true, y_pred)\n","    r2 = r2_score(y_true, y_pred)\n","\n","    print(f\"{set_name:>12} | RMSE: {rmse:6.2f} | MAE: {mae:6.2f} | R²: {r2:7.4f}\")\n","    return r2\n","\n","print(f\"{'Dataset':<12} | {'RMSE (MPa)':<11} | {'MAE (MPa)':<10} | {'R² Score'}\")\n","print(\"-\" * 55)\n","train_r2 = print_metrics(y_train, y_train_pred, \"Training\")\n","val_r2 = print_metrics(y_val, y_val_pred, \"Validation\")\n","test_r2 = print_metrics(y_test, y_test_pred, \"Test\")\n","\n","# Compare with Murakami equation\n","def murakami_equation(area, surface_defect, hardness):\n","    if surface_defect == 1:\n","        return 1.43 * (hardness + 120) / (area ** (1/6))\n","    else:\n","        return 1.56 * (hardness + 120) / (area ** (1/6))\n","\n","# Calculate Murakami predictions for test set\n","murakami_test_pred = []\n","for i in range(len(X_test)):\n","    area_val = X_test[:, 0][i]  # Original area from engineered features\n","    surf_val = X_test[:, 1][i]  # Surface defect\n","    hard_val = X_test[:, 2][i]  # Hardness\n","    pred = murakami_equation(area_val, surf_val, hard_val)\n","    murakami_test_pred.append(pred)\n","\n","murakami_test_pred = np.array(murakami_test_pred)\n","murakami_r2 = r2_score(y_test, murakami_test_pred)\n","\n","print(f\"{'Murakami Eq.':<12} | {'N/A':<11} | {'N/A':<10} | {murakami_r2:7.4f}\")\n","\n","# Success metrics\n","print(f\"\\n🎯 OPTIMIZATION RESULTS:\")\n","print(\"=\"*40)\n","if test_r2 > 0.95:\n","    print(f\"🏆 SUCCESS! Test R² = {test_r2:.4f} > 0.95\")\n","elif test_r2 > 0.90:\n","    print(f\"✅ GOOD! Test R² = {test_r2:.4f} > 0.90\")\n","elif test_r2 > 0.80:\n","    print(f\"📈 IMPROVED! Test R² = {test_r2:.4f} > 0.80\")\n","else:\n","    print(f\"⚠️  Needs more work: Test R² = {test_r2:.4f}\")\n","\n","print(f\"📊 Neural Network vs Murakami: {test_r2:.4f} vs {murakami_r2:.4f}\")\n","\n","# Visualization\n","fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n","\n","# Training history\n","axes[0, 0].plot(history.history['loss'], label='Training Loss')\n","axes[0, 0].plot(history.history['val_loss'], label='Validation Loss')\n","axes[0, 0].set_title('Optimized Model Training')\n","axes[0, 0].se