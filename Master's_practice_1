 {sum(surface_defect == -1)} samples\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xV7u16kWdBT8","executionInfo":{"status":"ok","timestamp":1758847192917,"user_tz":240,"elapsed":82,"user":{"displayName":"Shaan Virdee","userId":"12034033204395281865"}},"outputId":"8c931f29-3ace-4ecd-9543-1597c5850d80"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["🔧 Murakami Model Analysis: Neural Network vs Analytical Equation\n","======================================================================\n","📊 Dataset Overview:\n","   • Total samples: 100\n","   • Defect area range: 10.0 - 549.5 μm\n","   • Hardness range: 180.0 - 824.5 kg/mm²\n","   • Surface defects: 50 samples\n","   • No surface defects: 50 samples\n"]}]},{"cell_type":"code","source":["# MURAKAMI ANALYTICAL MODEL\n","def murakami_equation(area, surface_defect, hardness):\n","    \"\"\"\n","    Murakami model for endurance limit prediction\n","\n","    Parameters:\n","    - area: defect size sqrt(area) [μm]\n","    - surface_defect: 1 for surface defect, -1 for no surface defect\n","    - hardness: Vickers hardness [kg/mm²]\n","\n","    Returns:\n","    - endurance limit [MPa]\n","    \"\"\"\n","    if surface_defect == 1:\n","        # Surface defect present\n","        y = 1.43 * (hardness + 120) / (area ** (1/6))\n","    else:\n","        # No surface defect\n","        y = 1.56 * (hardness + 120) / (area ** (1/6))\n","\n","    return y\n","\n","# Apply Murakami equation to all data\n","print(f\"\\n🧮 Calculating Murakami Equation Predictions...\")\n","murakami_predictions = []\n","\n","for i in range(len(data)):\n","    area = defect_area.iloc[i]\n","    surf_def = surface_defect.iloc[i]\n","    hard = hardness.iloc[i]\n","\n","    pred = murakami_equation(area, surf_def, hard)\n","    murakami_predictions.append(pred)\n","\n","murakami_predictions = np.array(murakami_predictions)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oZjHkfpKd