\")\n","print(\"=\"*50)\n","print(f\"{'Metric':<15} {'Murakami Eq.':<15} {'Neural Net':<15} {'Winner':<10}\")\n","print(\"-\" * 55)\n","print(f\"{'RMSE (MPa)':<15} {murakami_rmse:<15.2f} {nn_rmse:<15.2f} {'Murakami' if murakami_rmse < nn_rmse else 'Neural Net':<10}\")\n","print(f\"{'MAE (MPa)':<15} {murakami_mae:<15.2f} {nn_mae:<15.2f} {'Murakami' if murakami_mae < nn_mae else 'Neural Net':<10}\")\n","print(f\"{'R² Score':<15} {murakami_r2:<15.4f} {nn_r2:<15.4f} {'Murakami' if murakami_r2 > nn_r2 else 'Neural Net':<10}\")\n","\n","# Create comprehensive visualization\n","fig, axes = plt.subplots(2, 3, figsize=(20, 12))\n","\n","# 1. Murakami Equation: Predicted vs Actual\n","axes[0, 0].scatter(actual_endurance, murakami_predictions, alpha=0.7, color='blue', s=50)\n","axes[0, 0].plot([actual_endurance.min(), actual_endurance.max()],\n","                [actual_endurance.min(), actual_endurance.max()], 'r--', linewidth=2)\n","axes[0, 0].set_title(f'Murakami Equation\\nR² = {murakami_r2:.4f}, RMSE = {murakami_rmse:.1f} MPa')\n","axes[0, 0].set_xlabel('Actual Endurance Limit (MPa)')\n","axes[0, 0].set_ylabel('Predicted Endurance Limit (MPa)')\n","axes[0, 0].grid(True, alpha=0.3)\n","\n","# 2. Neural Network: Predicted vs Actual\n","axes[0, 1].scatter(y, nn_predictions_full, alpha=0.7, color='green', s=50)\n","axes[0, 1].plot([y.min(), y.max()], [y.min(), y.max()], 'r--', linewidth=2)\n","axes[0, 1].set_title(f'Neural Network\\nR² = {nn_r2:.4f}, RMSE = {nn_rmse:.1f} MPa')\n","axes[0, 1].set_xlabel('Actual Endurance Limit (MPa)')\n","axes[0, 1].set_ylabel('Predicted Endurance Limit (MPa)')\n","axes[0, 1].grid(True, alpha=0.3)\n","\n","# 3. Direct Comparison: Murakami vs Neural Network\n","axes[0, 2].scatter(murakami_predictions, nn_predictions_full, alpha=0.7, color='purple', s=50)\n","axes[0, 2].plot([murakami_predictions.min(), murakami_predictions.max()],\n","                [murakami_predictions.min(), murakami_predictions.max()], 'r--', linewidth=2)\n","axes[0, 2].se